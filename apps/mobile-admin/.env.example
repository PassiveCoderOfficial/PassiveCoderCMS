EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Base URL of the Next.js backend for Bearer-authed API routes (domain
# connect/disconnect, and any future privileged endpoints this app calls).
# MUST be the www subdomain — the bare domain 307-redirects here, and React
# Native's fetch does not reliably forward the Authorization header across
# that redirect (confirmed: causes silent 401 "Unauthorized" on every
# Bearer-authed call).
EXPO_PUBLIC_API_BASE=https://www.passivecoder.com
