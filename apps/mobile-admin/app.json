{
  "expo": {
    "name": "Passive Coder Admin",
    "slug": "pc-admin",
    "owner": "passivecoder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pcadmin",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f2610c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.passivecoder.admin"
    },
    "android": {
      "package": "com.passivecoder.admin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#f2610c"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#f2610c"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#f2610c"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e168a148-a1b1-44d4-982c-2271ab0ad374"
      }
    }
  }
}
