# Passive Coder CMS (self-hosted, single site): environment.
# Copy to .env.local (or your host's environment settings) and fill in.

# --- Required -----------------------------------------------------------
NEXT_PUBLIC_CMS_MODE=standalone

# Supabase project (Settings > API): URL, publishable key, secret key.
# NEXT_PUBLIC_* values are built into the app: change one, rebuild.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Your site's address (no https:// on the first one).
NEXT_PUBLIC_ROOT_DOMAIN=www.example.com
NEXT_PUBLIC_APP_URL=https://www.example.com

# Database connection string (Settings > Database > Connect, "Session
# pooler"). Used only by the scripts in selfhost/ (setup-db, migrate,
# import-site), not by the running app.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# Long random strings. Generate each with: openssl rand -base64 32
APP_SECRET=
# Scheduled jobs: sent as "Authorization: Bearer <CRON_SECRET>" by
# crontab.example, the Docker cron service or Vercel.
CRON_SECRET=
# Optional: lets you start a job by hand with
#   curl -X POST -H "x-cron-secret: <value>" https://<site>/api/cron/<job>
# INTERNAL_CRON_SECRET=
# Exactly 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored
# payment and courier credentials; the app refuses to save them without it.
COURIER_SECRET_KEY=
# Recommended: a code the first-run /setup page asks for, so nobody else can
# claim a fresh install before you do (openssl rand -hex 16). Left empty,
# /setup is open to anyone who can reach the site until it has been run once.
SETUP_TOKEN=

# --- AI (optional) ------------------------------------------------------
# Passive Coder AI (recommended): one key, every AI feature, paid with AI
# credits. Create the key in your Passive Coder dashboard.
PASSIVECODER_AI_KEY=
# PASSIVECODER_AI_URL=https://passivecoder.com/api/ai/v1   (only if told to change it)
# Or your own key (Advanced: writing and rewriting text, site chat; whole-site
# building needs Passive Coder AI). Set one; AI_PROVIDER picks if you set several.
# AI_PROVIDER=openrouter|openai|anthropic|passivecoder
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides.
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Email (optional, recommended) --------------------------------------
# Resend (resend.com) for form notifications and other emails.
RESEND_API_KEY=
# Sender on a domain you verified in Resend.
EMAIL_FROM="Your Business <hello@example.com>"
EMAIL_FROM_ADDRESS=hello@example.com
# Where system notices go when no other address is set.
# SUPPORT_EMAIL=you@example.com

# --- Paid modules (optional) ----------------------------------------------
# A module licence (licence.json from Passive Coder) turns on the paid modules
# it lists for this site only. Checked offline, at start-up; restart after
# adding it. Without one, the free core modules work as normal.
# PASSIVECODER_LICENCE_FILE=/app/data/licence.json   default: licence.json in the app folder
# PASSIVECODER_LICENCE=          or the file's contents (JSON or base64), for hosts without a disk such as Vercel

# --- Other optional services ----------------------------------------------
# PEXELS_API_KEY=                     stock photos in the editor
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=    map blocks
# NEXT_PUBLIC_VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY=   web push alerts (npx web-push generate-vapid-keys)
# NEXT_PUBLIC_LOGO_URL=               logo on the sign-in page
# NEXT_PUBLIC_WHATSAPP_NUMBER=        default WhatsApp number, digits with country code
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=   connect Google Analytics and Search Console
# BING_CLIENT_ID= / BING_CLIENT_SECRET=       connect Bing Webmaster Tools
# INDEXNOW_KEY=                       tell search engines about new pages faster
# BDBULKSMS_TOKEN=                    SMS alerts (Bangladesh)
# CALLMEBOT_API_KEY=                  WhatsApp alerts through CallMeBot
# PATHAO_WEBHOOK_INTEGRATION_SECRET=  Pathao courier status updates
# UNSUBSCRIBE_SECRET= / PAGE_PREVIEW_SECRET=  separate signing secrets (default: APP_SECRET)
# STANDALONE_TENANT_ID=               only if the database holds more than one site
