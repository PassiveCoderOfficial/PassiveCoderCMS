# Next's webpack build exhausts the default ~2GB V8 heap on this project and
# dies with "Reached heap limit". Raised here rather than in the build script
# so `next build` still runs through its own launcher — invoking
# node --max-old-space-size against next/dist/bin/next directly crashes
# webpack's WASM hasher.
node-options=--max-old-space-size=4096
